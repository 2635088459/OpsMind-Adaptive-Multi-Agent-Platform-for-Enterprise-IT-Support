# Base URL of the real user-access-authentication-service BFF this app logs in
# through (SecurityConfig#browserLoginFilterChain / BrowserSessionTokenController).
# Must be an origin already present in that service's own
# app.identity.cors.allowed-origins AND its login.success-redirect-uri must
# point back at THIS app's own origin — the two are configured together, not
# independently (see application-local.yml).
VITE_BFF_BASE_URL=http://localhost:8087

# This app is the single sign-in front door for all three OpsMind personas. A
# signed-in user whose token carries support_agent / support_admin is handed off
# to this URL (the Support Console, apps/support-console), which re-authenticates
# itself silently there. Default is that app's own local-dev / full-platform.yml
# host port.
VITE_SUPPORT_CONSOLE_URL=http://localhost:5174
