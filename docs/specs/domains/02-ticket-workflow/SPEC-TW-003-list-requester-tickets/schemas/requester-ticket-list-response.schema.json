{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/ticket/requester-ticket-list-response.json",
  "title": "Requester Ticket List Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "page",
    "appliedFilters"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "ticket-summary.schema.json"
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "hasMore",
        "nextCursor"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "appliedFilters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "applicationCode",
        "createdFrom",
        "createdTo"
      ],
      "properties": {
        "status": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "applicationCode": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "HOUSING_PORTAL",
              "EMAIL",
              "VPN",
              "OTHER"
            ]
          }
        },
        "createdFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "createdTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
