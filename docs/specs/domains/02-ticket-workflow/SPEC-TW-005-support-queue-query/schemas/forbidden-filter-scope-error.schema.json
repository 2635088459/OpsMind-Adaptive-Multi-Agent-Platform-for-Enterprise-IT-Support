{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/ticket/forbidden-filter-scope-error.json",
  "title": "Forbidden Filter Scope Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "traceId",
        "correlationId",
        "details"
      ],
      "properties": {
        "code": {
          "const": "FILTER_OUTSIDE_AUTHORIZED_SCOPE"
        },
        "message": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
