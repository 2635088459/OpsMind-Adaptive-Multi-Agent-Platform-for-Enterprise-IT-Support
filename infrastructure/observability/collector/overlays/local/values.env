# owner: platform-observability
# spec: SPEC-OP-008
# rollback: git revert <sha>; recreate otel-collector
#
# LOCAL overlay parameters for the OTel Collector gateway (SPEC-OP-008, ADR-0007).
# OTEL_GATEWAY_AUTH_TOKEN is a NON-secret local-dev placeholder — this stack never
# leaves localhost. Production sources a real secret via its own secret-management
# mechanism; it is never committed here (repository-layout.md §5).

OTEL_GATEWAY_AUTH_TOKEN=local-dev-change-me
