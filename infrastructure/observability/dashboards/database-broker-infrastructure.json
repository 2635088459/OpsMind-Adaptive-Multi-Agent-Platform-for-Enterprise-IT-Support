{
  "__opsmind_meta": {
    "owner": "platform-observability",
    "version": "2.0.0",
    "spec": "SPEC-OP-029",
    "access_policy": "viewer: all-engineering; edit: platform-observability",
    "retention": "n/a (view only)",
    "runbook": "runbooks/DatabaseBrokerInfrastructure.md",
    "rollback": "git revert <sha>; re-run grafana provisioning (recreate grafana)",
    "audit_ref": "docs/traceability/domains/08-observability-platform/SPEC-OP-029-traceability.md"
  },
  "uid": "opsmind-database-broker-infrastructure",
  "title": "Database, Broker & Infrastructure",
  "tags": ["opsmind", "owner:platform-observability", "v:2.0.0", "spec:SPEC-OP-029"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "Database (application-level, via db.* namespace — SPEC-OP-006)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    { "id": 2, "type": "timeseries", "title": "DB operation rate by system/operation", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "sum by (db_system, db_operation) (rate(db_client_operation_duration_seconds_count[5m]))",
        "legendFormat": "{{db_system}} / {{db_operation}}" }] },

    { "id": 3, "type": "timeseries", "title": "DB operation p95 latency", "unit": "s",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, db_system, db_operation) (rate(db_client_operation_duration_seconds_bucket[5m])))",
        "legendFormat": "{{db_system}} / {{db_operation}}" }] },

    { "id": 4, "type": "row", "title": "RabbitMQ (application-level, via amqp.* namespace — SPEC-OP-006)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },

    { "id": 5, "type": "timeseries", "title": "AMQP publish/consume rate by destination", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "publish {{messaging_destination_name}}",
          "expr": "sum by (messaging_destination_name) (rate(amqp_publish_duration_seconds_count[5m]))" },
        { "refId": "B", "legendFormat": "consume {{messaging_destination_name}}",
          "expr": "sum by (messaging_destination_name) (rate(amqp_consume_duration_seconds_count[5m]))" }
      ] },

    { "id": 6, "type": "timeseries", "title": "AMQP publish/consume p95 latency", "unit": "s",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, messaging_operation) (rate(amqp_publish_duration_seconds_bucket[5m])))",
        "legendFormat": "{{messaging_operation}}" }] },

    { "id": 7, "type": "row", "title": "Infrastructure (postgres_exporter / rabbitmq_prometheus — SPEC-OP-029)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },

    { "id": 8, "type": "timeseries", "title": "Postgres connection pool saturation", "unit": "percentunit",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backs the PostgresConnectionPoolNearSaturation alert (> 80% for 10m). Scrapes a dedicated obs-postgres/postgres_exporter pair in THIS stack, not local-platform.yml's shared business-schema instance — see this dashboard's own runbook for why.",
      "targets": [{ "refId": "A", "expr": "postgres:connections:ratio" }] },

    { "id": 9, "type": "timeseries", "title": "Postgres backends by database", "unit": "short",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "pg_stat_database_numbackends",
        "legendFormat": "{{datname}}" }] },

    { "id": 10, "type": "timeseries", "title": "RabbitMQ queue depth (total)", "unit": "short",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backs the RabbitmqQueueBacklogHigh alert (> 1000 for 15m).",
      "targets": [{ "refId": "A", "expr": "rabbitmq:queue_depth:sum" }] },

    { "id": 11, "type": "timeseries", "title": "RabbitMQ queue depth by queue", "unit": "short",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "rabbitmq_queue_messages",
        "legendFormat": "{{queue}}" }] }
  ]
}
