{
  "__opsmind_meta": {
    "owner": "platform-observability",
    "version": "1.0.0",
    "spec": "SPEC-OP-017",
    "access_policy": "viewer: all-engineering; edit: platform-observability",
    "retention": "n/a (view only)",
    "runbook": "runbooks/DomainOperationalOverview.md",
    "rollback": "git revert <sha>; re-run grafana provisioning (recreate grafana)",
    "audit_ref": "docs/traceability/domains/08-observability-platform/SPEC-OP-017-traceability.md"
  },
  "uid": "opsmind-domain-operational-overview",
  "title": "Domain Operational Overview",
  "tags": ["opsmind", "owner:platform-observability", "v:1.0.0", "spec:SPEC-OP-017"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "domain",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(service_namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "agent-runtime", "value": "agent-runtime" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "$domain — lifecycle", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    { "id": 2, "type": "timeseries", "title": "Request / operation rate", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Union of every namespace this domain might emit (http/db/amqp/agent/evaluation) — only the ones it actually uses show series.",
      "targets": [{ "refId": "A",
        "expr": "sum by (service_name, __name__) (rate({__name__=~\"http_server_request_duration_seconds_count|db_client_operation_duration_seconds_count|amqp_publish_duration_seconds_count|amqp_consume_duration_seconds_count|agent_run_duration_seconds_count|evaluation_case_duration_seconds_count\", service_namespace=\"$domain\"}[5m]))",
        "legendFormat": "{{service_name}} / {{__name__}}" }] },

    { "id": 3, "type": "timeseries", "title": "Error / failure outcome rate", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "sum by (service_name, __name__) (rate({__name__=~\"http_server_request_duration_seconds_count|db_client_operation_duration_seconds_count|amqp_publish_duration_seconds_count|amqp_consume_duration_seconds_count|agent_run_duration_seconds_count|evaluation_case_duration_seconds_count\", service_namespace=\"$domain\", outcome=\"failure\"}[5m]))",
        "legendFormat": "{{service_name}} / {{__name__}}" }] },

    { "id": 4, "type": "row", "title": "$domain — backlog & throughput", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 } },

    { "id": 5, "type": "timeseries", "title": "AMQP publish/consume rate", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "A sustained publish > consume gap is a growing backlog — cross-check the broker's own queue-depth panel (SPEC-OP-018) once RabbitMQ's exporter is deployed.",
      "targets": [
        { "refId": "A", "legendFormat": "publish",
          "expr": "sum(rate(amqp_publish_duration_seconds_count{service_namespace=\"$domain\"}[5m]))" },
        { "refId": "B", "legendFormat": "consume",
          "expr": "sum(rate(amqp_consume_duration_seconds_count{service_namespace=\"$domain\"}[5m]))" }
      ] },

    { "id": 6, "type": "timeseries", "title": "DB operation p95 latency", "unit": "s",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, db_operation) (rate(db_client_operation_duration_seconds_bucket{service_namespace=\"$domain\"}[5m])))",
        "legendFormat": "{{db_operation}}" }] },

    { "id": 7, "type": "row", "title": "$domain — audit (structured logs)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 } },

    { "id": 8, "type": "logs", "title": "Recent logs (this domain)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\".+\"} | service_namespace = \"$domain\"" }] },

    { "id": 9, "type": "logs", "title": "Structured-log contract violations (this domain)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "opsmind.log.violation set by SPEC-OP-007 — missing linkage, unspecified severity, or a malformed event.code.",
      "targets": [{ "refId": "A", "expr": "{service_name=~\".+\"} | service_namespace = \"$domain\" | opsmind_log_violation != ``" }] }
  ]
}
