    "access_policy": "viewer: all-engineering; edit: platform-observability",
    "retention": "n/a (view only)",
    "runbook": "runbooks/ToolPolicyBusinessSignals.md",
    "rollback": "git revert <sha>; re-run grafana provisioning (recreate grafana)",
    "audit_ref": "docs/traceability/domains/08-observability-platform/SPEC-OP-027-traceability.md"
  },
  "uid": "opsmind-tool-policy-business-signals",
  "title": "Tool & Policy Business Signals",
  "tags": ["opsmind", "owner:platform-observability", "v:1.0.0", "spec:SPEC-OP-027"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "Tool (tool-integration-gateway)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    { "id": 2, "type": "timeseries", "title": "Tool request lifecycle", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "SPEC-TG-026's real ToolGatewayTelemetry, contracted here for the first time (SPEC-OP-027).",
      "targets": [
        { "refId": "A", "legendFormat": "created", "expr": "sum(rate(tool_request_created_total[5m]))" },
        { "refId": "B", "legendFormat": "completed", "expr": "sum(rate(tool_request_completed_total[5m]))" }
      ] },

    { "id": 3, "type": "timeseries", "title": "Connector error / timeout rate", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backs the ToolConnectorErrorRateHigh alert (error rate > 0 for 10m).",
      "targets": [
        { "refId": "A", "legendFormat": "error", "expr": "tool:connector_error:rate5m" },
        { "refId": "B", "legendFormat": "timeout", "expr": "sum(rate(tool_connector_timeout_total[5m]))" }
      ] },

    { "id": 4, "type": "timeseries", "title": "Outbox pending / credential access", "unit": "short",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "outbox pending (gauge)", "expr": "tool_outbox_pending_count" },
        { "refId": "B", "legendFormat": "credential access/s", "expr": "sum(rate(tool_credential_access_total[5m]))" }
      ] },

    { "id": 5, "type": "row", "title": "Policy & Approval (policy-approval-governance-service)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 } },

    { "id": 6, "type": "timeseries", "title": "Policy decisions by effect", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "SPEC-PG-0xx's real MicrometerGovernanceMetrics, contracted here for the first time (SPEC-OP-027). effect is DecisionEffect {ALLOW, DENY, REQUIRE_STEP_UP}.",
      "targets": [{ "refId": "A",
        "expr": "sum by (effect) (rate(policy_decision_total[5m]))",
        "legendFormat": "{{effect}}" }] },

    { "id": 7, "type": "timeseries", "title": "Degraded-mode decision rate", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backs the (critical, paging) GovernancePolicyDegradedSustained alert (> 0 for 5m). SPEC-PG-032's own Degraded Policy Mode.",
      "targets": [{ "refId": "A", "expr": "governance:policy_degraded:rate5m" }] },

    { "id": 8, "type": "timeseries", "title": "Approval requests vs decisions", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "requested", "expr": "sum(rate(approval_request_created_total[5m]))" },
        { "refId": "B", "legendFormat": "decided", "expr": "sum(rate(approval_decision_total[5m]))" },
        { "refId": "C", "legendFormat": "expired", "expr": "sum(rate(approval_expired_total[5m]))" }
      ] },

    { "id": 9, "type": "timeseries", "title": "Governance override rate", "unit": "ops",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(governance_override_total[5m]))" }] }
  ]
}
