# OpsMind Observability Platform — pinned component versions
# Spec: SPEC-OP-001  |  Owner: platform-observability
#
# Rules (enforced by scripts/validate-observability-layout.py):
#   - every component has a _TAG and a _DIGEST entry
#   - _TAG is an exact version, never "latest" and never a floating major/minor
#   - _DIGEST is "sha256:<64 hex>", pinned from `docker inspect` after first pull
#     (SPEC-OP-002); the literal "PENDING-SPEC-OP-002" is still accepted (validator
#     warns, does not fail) for a component not yet brought up
#   - an upgrade is a reviewed PR that changes both _TAG and _DIGEST together
#
# Consumed by: infrastructure/docker-compose (SPEC-OP-002) and production
# deployment overlays (SPEC-OP-008+). Do not reference image tags anywhere else.

# --- OpenTelemetry Collector (contrib distribution) ---
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib
OTEL_COLLECTOR_TAG=0.116.1
OTEL_COLLECTOR_DIGEST=sha256:d0ebf65280da2e1b1491d1b93648281afd353d4b9ea19160090303cec9a233bd

# --- Prometheus ---
PROMETHEUS_IMAGE=prom/prometheus
PROMETHEUS_TAG=v3.1.0
PROMETHEUS_DIGEST=sha256:6559acbd5d770b15bb3c954629ce190ac3cbbdb2b7f1c30f0385c4e05104e218

# --- Loki ---
LOKI_IMAGE=grafana/loki
LOKI_TAG=3.3.2
LOKI_DIGEST=sha256:8af2de1abbdd7aa92b27c9bcc96f0f4140c9096b507c77921ffddf1c6ad6c48f

# --- Tempo ---
TEMPO_IMAGE=grafana/tempo
TEMPO_TAG=2.7.1
TEMPO_DIGEST=sha256:4443be217c396b065ee34845534199c36fdba4dc619cb96550e228d73fba6e69

# --- Grafana ---
GRAFANA_IMAGE=grafana/grafana
GRAFANA_TAG=11.4.0
GRAFANA_DIGEST=sha256:d8ea37798ccc41061a62ab080f2676dda6bf7815558499f901bdb0f533a456fb

# --- Alertmanager ---
ALERTMANAGER_IMAGE=prom/alertmanager
ALERTMANAGER_TAG=v0.28.0
ALERTMANAGER_DIGEST=sha256:d5155cfac40a6d9250ffc97c19db2c5e190c7bc57c6b67125c94903358f8c7d8

# --- Postgres (SPEC-OP-029) — a small, dedicated instance purely so
# postgres_exporter has something real to scrape; this is NOT the shared
# business-schema Postgres local-platform.yml runs for domain services (a
# separate compose project, a separate volume, no shared data). ---
POSTGRES_IMAGE=postgres
POSTGRES_TAG=16-alpine
POSTGRES_DIGEST=sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685

# --- postgres_exporter (SPEC-OP-029) ---
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter
POSTGRES_EXPORTER_TAG=v0.15.0
POSTGRES_EXPORTER_DIGEST=sha256:386b12d19eab2a37d7cd8ca8b4c7491cc7a830d9581f49af6c98a393da9605e6

# --- RabbitMQ (SPEC-OP-029) — same tag local-platform.yml already pins, for
# consistency; a separate dedicated instance for the same reason as Postgres
# above. Exposes metrics via its OWN built-in `rabbitmq_prometheus` plugin
# (enabled at startup below) — no separate rabbitmq_exporter container needed,
# unlike Postgres which has no native Prometheus endpoint. ---
RABBITMQ_IMAGE=rabbitmq
RABBITMQ_TAG=4.3.4-management
RABBITMQ_DIGEST=sha256:eb5295d083325da5929a5ade766684d4019ffd2bce8bc7e43d6f9a05cafc8646
