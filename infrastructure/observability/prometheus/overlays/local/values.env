# owner: platform-observability
# spec: SPEC-OP-002
# rollback: git revert <sha>; recreate prometheus
#
# LOCAL overlay parameters for Prometheus. Consumed by
# infrastructure/docker-compose/observability-stack.yml (env_file + command flags).
# Only environment parameters — never rule or scrape logic (that is base/ + ../rules/).

# Short retention for a laptop; production value is set by SPEC-OP-015.
PROMETHEUS_RETENTION_TIME=72h
PROMETHEUS_RETENTION_SIZE=2GB

# tsdb lives on a named volume mounted at this path.
PROMETHEUS_STORAGE_PATH=/prometheus

# deployment.environment external label for this overlay.
PROMETHEUS_ENV_LABEL=local
