{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/observability/telemetry-governance.schema.json",
  "title": "OpsMind Telemetry Governance Baseline",
  "description": "Structure of infrastructure/observability/governance/telemetry-governance.yaml. Spec: SPEC-OP-003. Enforced by scripts/validate-telemetry-governance.py (hand-rolled check; no jsonschema dependency).",
  "type": "object",
  "required": [
    "version",
    "deny_fields",
    "allow_fields",
    "retention_classes",
    "signal_owners",
    "cardinality_budgets",
    "schema_review",
    "exceptions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "deny_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern", "reason"],
        "additionalProperties": false,
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allow_fields": {
      "type": "object",
      "required": ["resource", "span", "log", "metric_datapoint"],
      "additionalProperties": false,
      "patternProperties": {
        "^(resource|span|log|metric_datapoint)$": {
          "type": "object",
          "required": ["required", "recommended"],
          "additionalProperties": false,
          "properties": {
            "required": { "type": "array", "items": { "type": "string" } },
            "recommended": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "retention_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "local", "ci", "prod"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "local": { "type": "string", "pattern": "^\\d+[hdwy]$" },
          "ci": { "type": "string", "pattern": "^\\d+[hdwy]$" },
          "prod": { "type": "string", "pattern": "^\\d+[hdwy]$" }
        }
      }
    },
    "signal_owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family", "semantic_owner", "transport_owner"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string" },
          "semantic_owner": { "type": "string" },
          "transport_owner": { "type": "string" }
        }
      }
    },
    "cardinality_budgets": {
      "type": "object",
      "required": ["global", "namespaces"],
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "object",
          "required": ["max_series_total"],
          "additionalProperties": false,
          "properties": { "max_series_total": { "type": "integer", "minimum": 1 } }
        },
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["namespace", "max_label_keys", "max_series", "forbidden_labels"],
            "additionalProperties": false,
            "properties": {
              "namespace": { "type": "string" },
              "max_label_keys": { "type": "integer", "minimum": 0 },
              "max_series": { "type": "integer", "minimum": 1 },
              "forbidden_labels": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "schema_review": {
      "type": "object",
      "required": ["rule", "additive_change", "breaking_change", "forbidden", "gate"],
      "additionalProperties": false,
      "properties": {
        "rule": { "type": "string" },
        "additive_change": { "type": "string" },
        "breaking_change": { "type": "string" },
        "forbidden": { "type": "string" },
        "gate": { "type": "string" }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "scope", "reason", "owner", "approved_by", "opened", "expires", "ticket"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^TGX-\\d{3,}$" },
          "rule": { "type": "string" },
          "scope": { "type": "string" },
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "approved_by": { "type": "string" },
          "opened": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "ticket": { "type": "string" }
        }
      }
    }
  }
}
