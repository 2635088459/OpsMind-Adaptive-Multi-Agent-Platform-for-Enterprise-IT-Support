{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/observability/resource-attributes.schema.json",
  "title": "OpsMind Resource Attribute Convention",
  "description": "Structure of infrastructure/observability/signals/resource-attributes.yaml. Spec: SPEC-OP-004. Checked by scripts/validate-signal-contracts.py.",
  "type": "object",
  "required": [
    "version",
    "namespaces",
    "environments",
    "attributes",
    "missing_service_name_default",
    "violation_attribute"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]+$" }
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "level", "semconv", "cardinality", "source"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "level": { "enum": ["required", "recommended", "optional"] },
          "value_pattern": { "type": "string" },
          "value_enum_ref": { "enum": ["namespaces", "environments"] },
          "semconv": { "type": "string" },
          "cardinality": { "enum": ["bounded", "replica-scoped", "unbounded"] },
          "source": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "missing_service_name_default": { "type": "string", "minLength": 1 },
    "violation_attribute": { "type": "string", "pattern": "^[a-z0-9_.]+$" }
  }
}
