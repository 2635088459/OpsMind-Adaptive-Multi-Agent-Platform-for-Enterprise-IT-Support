{
  "realm": "opsmind",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "it-support@opsmind.dev",
    "fromDisplayName": "OpsMind IT Support",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "description": "Real bug found live 2026-09-02: same root cause as 'profile' below (a declared clientScopes array drops Keycloak's built-ins) but for the mapper that puts sub into a browser login's access token.",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "sub",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "description": "Real bug found live 2026-09-01: a declared clientScopes array replaces Keycloak's built-in defaults rather than supplementing them, so profile/email must be added back explicitly.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "tickets:create",
      "protocol": "openid-connect",
      "description": "Real client scope (not a hardcoded-claim mapper -- Keycloak's own reserved `scope` claim accounting silently overrides a hardcoded mapper targeting it, found live 2026-09-01) so `tickets:create` lands in the token's `scope` claim.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "tickets:read:self",
      "protocol": "openid-connect",
      "description": "Real bug found live 2026-09-03: TicketViewPolicy's own EMPLOYEE_VIEW required this scope but it never existed in this realm.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:resolution-confirm",
      "protocol": "openid-connect",
      "description": "SPEC-EP-016 / SPEC-TW-026: ConfirmResolutionApplicationService requires this scope. Added 2026-09-08 (frontend integration verification) — the employee portal's confirm path 403'd without it.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:reopen-request",
      "protocol": "openid-connect",
      "description": "Real gap found live 2026-09-08 (frontend integration verification): RequesterReopenTicketApplicationService requires this scope (SPEC-EP-017 reopen / SPEC-TW-028) but it never existed in this realm, so the employee portal's reopen path 403'd end-to-end.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "tickets:message:self",
      "protocol": "openid-connect",
      "description": "AddTicketMessageApplicationService requires this scope for a PUBLIC_REQUESTER_MESSAGE (SPEC-TW-004). Added 2026-09-08 so the employee portal / demo seed can post requester replies.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "tickets:message:public",
      "protocol": "openid-connect",
      "description": "AddTicketMessageApplicationService requires this scope for a PUBLIC_SUPPORT_MESSAGE (SPEC-TW-004). Added 2026-09-08 so the support console / demo seed can post agent replies.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:triage",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:resolve",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:close",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:request-approval",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:transition",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:assign-route",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ticket:assign",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "governance:audit:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "approval:decide",
      "protocol": "openid-connect",
      "description": "SPEC-PG-014: RBAC half of approval grant/deny (JwtIdentityAuthorizationAdapter#isAuthorizedApprover needs SCOPE_approval:decide). ABAC half is the risk_clearance claim.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "risk-clearance",
      "protocol": "openid-connect",
      "description": "SPEC-PG-014: emits the risk_clearance claim (RiskLevel names) JwtIdentityAuthorizationAdapter#hasRiskClearance reads. Hardcoded to full clearance; a production IdP sets it per principal. approval:decide is the real RBAC gate.",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "risk-clearance-hardcoded",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "risk_clearance",
            "claim.value": "[\"LOW\",\"MEDIUM\",\"HIGH\",\"CRITICAL\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "policy:read",
      "protocol": "openid-connect",
      "description": "Read side of the Admin Policy API (GET /api/v1/policies, GET /api/v1/policies/{id}) — support-console's Policy admin list/detail view.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "policy:draft",
      "protocol": "openid-connect",
      "description": "POST /api/v1/policies:draft (PolicyAdminController @PreAuthorize SCOPE_policy:draft).",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "policy:review",
      "protocol": "openid-connect",
      "description": "POST /api/v1/policy-versions/{id}:review. The service still enforces actor-level reviewer/publisher separation of duties on top of this scope.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "policy:publish",
      "protocol": "openid-connect",
      "description": "POST /api/v1/policy-versions/{id}:publish.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "description": "SPEC-SC-002: exposes the user's real realm roles (support_agent/support_admin) as realm_access.roles -- UI-gating convenience only, never a security boundary (this domain's own honest framing).",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "tickets:read:queue",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "tickets:timeline:internal",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "users": [
    {
      "username": "test.agent",
