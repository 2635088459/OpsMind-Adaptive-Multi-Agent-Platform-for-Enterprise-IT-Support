{
  "realm": "opsmind",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "profile",
      "protocol": "openid-connect",
      "description": "Real bug found live 2026-09-01: a declared clientScopes array replaces Keycloak's built-in defaults rather than supplementing them, so profile/email must be added back explicitly.",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"},
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"},
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "tickets:create",
      "protocol": "openid-connect",
      "description": "Real client scope (not a hardcoded-claim mapper -- Keycloak's own reserved `scope` claim accounting silently overrides a hardcoded mapper targeting it, found live 2026-09-01) so `tickets:create` lands in the token's `scope` claim.",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ticket:triage",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ticket:resolve",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ticket:close",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ticket:request-approval",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ticket:transition",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ticket:assign-route",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "ticket:assign",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    }
  ],
  "users": [
    {
      "username": "test.agent",
      "email": "test.agent@opsmind.dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Agent",
      "credentials": [
        {
          "type": "password",
          "value": "test-password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "user-access-authentication-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "user-access-secret",
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:8087/login/oauth2/code/opsmind",
        "http://localhost:8087/login/oauth2/code/opsmind-stepup"
      ],
      "webOrigins": ["http://localhost:8087"],
      "defaultClientScopes": ["profile", "email"]
    },
    {
      "clientId": "integration-test-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "integration-test-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "defaultClientScopes": [
        "tickets:create",
        "ticket:triage",
        "ticket:resolve",
        "ticket:close",
        "ticket:request-approval",
        "ticket:transition",
        "ticket:assign-route",
        "ticket:assign"
      ],
      "protocolMappers": [
        {
          "name": "actor-type-support-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "actor_type",
            "claim.value": "SUPPORT_AGENT",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "support-teams-network",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "support_teams",
            "claim.value": "network-support-team",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
