<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="serviceName" source="spring.application.name"
                     defaultValue="ticket-workflow-service"/>
    <property name="ENVIRONMENT" value="${ENVIRONMENT:-local}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%p","service":"${serviceName}","environment":"${ENVIRONMENT}","logger":"%logger{40}","traceId":"%X{traceId:-}","message":"%replace(%msg){'"','\\"'}"}%n%wEx</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
