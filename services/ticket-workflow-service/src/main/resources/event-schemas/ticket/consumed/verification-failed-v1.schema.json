{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/consumed/verification-failed-v1.schema.json",
  "title": "verification.failed.v1 payload (consumed)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "workflowId",
    "resolutionCycleId",
    "verificationId",
    "attemptNumber",
    "failureCode",
    "failureClass",
    "unsafe",
    "failedAt"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resolutionCycleId": {
      "type": "string",
      "format": "uuid"
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1
    },
    "failureCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "failureClass": {
      "type": "string",
      "enum": ["RETRYABLE", "PIPELINE_FAILED"]
    },
    "unsafe": {
      "type": "boolean"
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
