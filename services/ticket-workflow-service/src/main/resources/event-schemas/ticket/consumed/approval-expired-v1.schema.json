{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/consumed/approval-expired-v1.schema.json",
  "title": "approval.expired.v1 payload (consumed)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "workflowId",
    "actionId",
    "approvalId",
    "expiredAt"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expiredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
