{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/consumed/tool-execution-completed-v1.schema.json",
  "title": "tool.execution.completed.v1 payload (consumed)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "workflowId",
    "actionId",
    "authorizationReference",
    "toolExecutionId",
    "toolResultId",
    "completedAt"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionType": {
      "type": "string",
      "maxLength": 64
    },
    "authorizationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "toolExecutionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "toolResultId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resultSummary": {
      "type": ["object", "null"]
    }
  }
}
