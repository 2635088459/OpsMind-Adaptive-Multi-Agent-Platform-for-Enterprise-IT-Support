{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-user-input-requested-v1.schema.json",
  "title": "ticket.user-input-requested.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supportQueueId",
    "assigneeId",
    "requestId",
    "previousStatus",
    "newStatus",
    "requestedBy",
    "requestedAt",
    "waitingForRequesterSince",
    "resumeStatus"
  ],
  "properties": {
    "supportQueueId": {
      "type": "string",
      "format": "uuid"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "previousStatus": {
      "type": "string",
      "const": "IN_PROGRESS"
    },
    "newStatus": {
      "type": "string",
      "const": "WAITING_FOR_USER"
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "waitingForRequesterSince": {
      "type": "string",
      "format": "date-time"
    },
    "resumeStatus": {
      "type": "string",
      "const": "IN_PROGRESS"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
