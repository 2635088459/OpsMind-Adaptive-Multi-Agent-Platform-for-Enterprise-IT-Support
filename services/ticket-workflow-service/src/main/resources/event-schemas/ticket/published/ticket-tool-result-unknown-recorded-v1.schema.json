{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-tool-result-unknown-recorded-v1.schema.json",
  "title": "ticket.tool-result-unknown-recorded.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supportQueueId",
    "assigneeId",
    "ticketId",
    "workflowId",
    "actionId",
    "authorizationReference",
    "toolExecutionId",
    "unknownReason",
    "previousStatus",
    "newStatus",
    "observedAt",
    "reconciliationRequired"
  ],
  "properties": {
    "supportQueueId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1
    },
    "ticketId": {
      "type": "string",
      "format": "uuid"
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorizationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "toolExecutionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unknownReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceReferences": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "previousStatus": {
      "type": "string",
      "const": "EXECUTING"
    },
    "newStatus": {
      "type": "string",
      "const": "ESCALATED"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reconciliationRequired": {
      "type": "boolean"
    }
  }
}
