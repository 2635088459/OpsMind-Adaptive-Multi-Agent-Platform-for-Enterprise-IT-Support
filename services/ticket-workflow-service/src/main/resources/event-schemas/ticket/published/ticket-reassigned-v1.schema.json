{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-reassigned-v1.schema.json",
  "title": "ticket.reassigned.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["supportQueueId", "previousAssigneeId", "assigneeId", "status", "reason"],
  "properties": {
    "supportQueueId": {
      "type": "string",
      "format": "uuid"
    },
    "previousAssigneeId": {
      "type": "string",
      "minLength": 1
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ASSIGNED", "IN_PROGRESS", "WAITING_FOR_USER", "WAITING_FOR_APPROVAL"]
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    }
  }
}
