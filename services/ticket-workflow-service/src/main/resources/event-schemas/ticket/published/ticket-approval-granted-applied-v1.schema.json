{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-approval-granted-applied-v1.schema.json",
  "title": "ticket.approval-granted-applied.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supportQueueId",
    "assigneeId",
    "ticketId",
    "approvalRequestId",
    "approvalId",
    "workflowId",
    "actionId",
    "actionType",
    "approvedAt",
    "authorizationReference"
  ],
  "properties": {
    "supportQueueId": {
      "type": "string",
      "format": "uuid"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1
    },
    "ticketId": {
      "type": "string",
      "format": "uuid"
    },
    "approvalRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "approvalId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authorizationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
