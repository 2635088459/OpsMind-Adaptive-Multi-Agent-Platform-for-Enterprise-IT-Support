{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-message-added-v1.schema.json",
  "title": "ticket.message.added.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "ticketId", "messageType", "visibility", "authorType", "createdAt"],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "ticketId": {
      "type": "string",
      "format": "uuid"
    },
    "messageType": {
      "type": "string",
      "enum": ["PUBLIC_REQUESTER_MESSAGE", "PUBLIC_SUPPORT_MESSAGE", "INTERNAL_SUPPORT_NOTE"]
    },
    "visibility": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL"]
    },
    "authorType": {
      "type": "string",
      "enum": ["EMPLOYEE", "IT_SUPPORT", "IT_ADMIN", "IT_MANAGER"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
