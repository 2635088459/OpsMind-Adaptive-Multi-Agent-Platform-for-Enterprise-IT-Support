{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-auto-approval-applied-v1.schema.json",
  "title": "ticket.auto-approval-applied.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supportQueueId",
    "assigneeId",
    "ticketId",
    "approvalRequestId",
    "workflowId",
    "actionId",
    "actionType",
    "riskLevel",
    "policyId",
    "policyVersion",
    "policyDecisionId",
    "authorizationReference",
    "decidedAt"
  ],
  "properties": {
    "supportQueueId": {
      "type": "string",
      "format": "uuid"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1
    },
    "ticketId": {
      "type": "string",
      "format": "uuid"
    },
    "approvalRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "riskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "policyDecisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorizationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
