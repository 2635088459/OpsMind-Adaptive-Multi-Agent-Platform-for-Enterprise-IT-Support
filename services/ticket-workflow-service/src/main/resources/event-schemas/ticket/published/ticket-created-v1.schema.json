{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-created-v1.schema.json",
  "title": "ticket.created.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayId", "requesterIdHash", "applicationCode", "source", "initialStatus", "createdAt"],
  "properties": {
    "displayId": {
      "type": "string",
      "pattern": "^INC-[1-9][0-9]*$"
    },
    "requesterIdHash": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "applicationCode": {
      "type": "string",
      "enum": ["HOUSING_PORTAL", "EMAIL", "VPN", "OTHER"]
    },
    "source": {
      "type": "string",
      "enum": ["PORTAL", "EMAIL", "API", "SYSTEM"]
    },
    "initialStatus": {
      "type": "string",
      "const": "NEW"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
