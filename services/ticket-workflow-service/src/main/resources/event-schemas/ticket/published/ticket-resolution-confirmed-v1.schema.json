{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-resolution-confirmed-v1.schema.json",
  "title": "ticket.resolution-confirmed.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supportQueueId",
    "assigneeId",
    "resolutionCycleId",
    "previousStatus",
    "newStatus",
    "reasonCode",
    "reason",
    "confirmedBy",
    "confirmedAt"
  ],
  "properties": {
    "supportQueueId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1
    },
    "resolutionCycleId": {
      "type": "string",
      "format": "uuid"
    },
    "previousStatus": {
      "type": "string",
      "const": "RESOLVED"
    },
    "newStatus": {
      "type": "string",
      "const": "CLOSED"
    },
    "reasonCode": {
      "type": "string",
      "enum": ["REQUESTER_CONFIRMED", "SUPPORT_CONFIRMED"]
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "confirmedBy": {
      "type": "string",
      "minLength": 1
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
