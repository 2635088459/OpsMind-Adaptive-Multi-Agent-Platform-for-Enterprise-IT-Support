{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.dev/schemas/events/ticket/published/ticket-tool-execution-completed-applied-v1.schema.json",
  "title": "ticket.tool-execution-completed-applied.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supportQueueId",
    "assigneeId",
    "ticketId",
    "workflowId",
    "actionId",
    "authorizationReference",
    "toolExecutionId",
    "toolResultId",
    "previousStatus",
    "newStatus",
    "completedAt"
  ],
  "properties": {
    "supportQueueId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1
    },
    "ticketId": {
      "type": "string",
      "format": "uuid"
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorizationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "toolExecutionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "toolResultId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "previousStatus": {
      "type": "string",
      "const": "EXECUTING"
    },
    "newStatus": {
      "type": "string",
      "const": "VERIFYING"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resultSummary": {
      "type": ["object", "null"]
    }
  }
}
